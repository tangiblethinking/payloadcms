{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs"
    },
    "tanstack-start": {
      "root": "packages/tanstack-start",
      "framework": "vite"
    },
    "template": {
      "root": "templates/_template",
      "framework": "nextjs"
    },
    "blank": {
      "root": "templates/blank",
      "framework": "nextjs"
    },
    "blank-tanstack": {
      "root": "templates/blank-tanstack",
      "framework": "vite"
    },
    "ecommerce": {
      "root": "templates/ecommerce",
      "framework": "nextjs"
    },
    "plugin": {
      "root": "templates/plugin",
      "framework": "nextjs"
    },
    "website": {
      "root": "templates/website",
      "framework": "nextjs"
    },
    "with-cloudflare-d1": {
      "root": "templates/with-cloudflare-d1",
      "framework": "nextjs"
    },
    "with-postgres": {
      "root": "templates/with-postgres",
      "framework": "nextjs"
    },
    "with-vercel-mongodb": {
      "root": "templates/with-vercel-mongodb",
      "framework": "nextjs"
    },
    "with-vercel-postgres": {
      "root": "templates/with-vercel-postgres",
      "framework": "nextjs"
    },
    "with-vercel-website": {
      "root": "templates/with-vercel-website",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
